#!/bin/sh
# Atelier AppImage entry: the GUI by default; `cli ARGS…` (or a link
# named atelier) runs the command line, the TUI and the service.
here="$(dirname "$(readlink -f "$0")")"
export PATH="$here/usr/bin:$PATH"
case "$(basename "${ARGV0:-$0}")" in
  atelier) exec "$here/usr/bin/atelier" "$@" ;;
esac
if [ "$1" = "cli" ]; then
  shift
  exec "$here/usr/bin/atelier" "$@"
fi
exec "$here/usr/bin/atelier-gui" "$@"
