[Desktop Entry]
Type=Application
Name=Copilot Canvas
GenericName=Agent session canvas
Comment=An infinite canvas of AI coding-agent sessions in real terminals
Exec=copilot-canvas-gui %F
TryExec=copilot-canvas-gui
Icon=copilot-canvas
Terminal=false
Categories=Development;IDE;TerminalEmulator;
Keywords=copilot;opencode;claude;agent;terminal;canvas;
StartupNotify=true
StartupWMClass=copilot-canvas
X-GNOME-UsesNotifications=true
