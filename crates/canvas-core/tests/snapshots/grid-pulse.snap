## gpu view model
view cursor=none modal=none banner=None
canvas area=34,1 116x38 origin=-1,0 scale=1 grid=true tick=0 empty=false
grid pulse on=true envelope=1 level=0.35 color=#48576b
box busy Session rect=1,1 30x4 prefix="" name="Working on it"
  status=Working icon="⠋" label="working" line="⠋ working" subtitle="canvas · main" elsewhere=true every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #c9d1d9]
  selected=false focused_term=false active=false
box quiet Session rect=40,1 30x4 prefix="" name="Idle one"
  status=Idle icon="○" label="idle" line="○ idle" subtitle="canvas · main" elsewhere=true every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #8b949e]
  selected=false focused_term=false active=false
