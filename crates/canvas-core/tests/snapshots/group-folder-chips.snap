## gpu view model
view cursor=none modal=none banner=None
canvas area=34,1 52x38 origin=-1,-1 scale=1 grid=true tick=0 empty=false
group g-docs "Docs" icon=▣ members=2 rect=0,0 48x13 color=#e69f00 style=[fg #e69f00 +BOLD] selected=true drop_target=false automations=false folder=true
  chip " ⟲+ " action=NewPassive("g-docs") rect=17,0 4x1 fixed=false lit=false
  chip " ◧ AI docs " action=OpenGroupFolder("g-docs", false) rect=22,0 11x1 fixed=false lit=true
  chip " ◨ Outputs " action=OpenGroupFolder("g-docs", true) rect=34,0 11x1 fixed=false lit=true
group g-ideas "Ideas" icon=▣ members=1 rect=0,16 44x8 color=#cc79a7 style=[fg #cc79a7 +DIM] selected=false drop_target=false automations=false folder=false
  chip " ⟲+ " action=NewPassive("g-ideas") rect=21,16 4x1 fixed=false lit=false
  chip " ◧ Set folder… " action=SetGroupFolder("g-ideas") rect=26,16 15x1 fixed=false lit=false
box a Session rect=2,2 30x4 prefix="" name="Write the spec"
  status=Stopped icon="■" label="stopped" line="■ stopped" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #585e66]
  selected=false focused_term=false active=false
box b Session rect=2,7 30x4 prefix="" name="Draft the docs"
  status=Stopped icon="■" label="stopped" line="■ stopped" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #585e66]
  selected=false focused_term=false active=false
box c Session rect=2,18 30x4 prefix="" name="Unfiled idea"
  status=Stopped icon="■" label="stopped" line="■ stopped" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #585e66]
  selected=false focused_term=false active=false
