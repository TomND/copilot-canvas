## gpu view model
view cursor=none modal=none banner=None
canvas area=34,1 90x24 origin=-1,0 scale=1 grid=true tick=0 empty=false
box v-queued Session rect=1,1 30x4 prefix="☁ " name="Queued"
  status=Stopped icon="■" label="stopped" line="☁ queued: 4 of 4 VMs are running" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #6e7681]
  selected=false focused_term=false active=false
  vm=queued
box v-starting Session rect=41,1 30x4 prefix="☁ " name="Starting"
  status=Stopped icon="■" label="stopped" line="☁ starting…" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #58a6ff]
  selected=false focused_term=false active=false
  vm=starting
box v-running Session rect=81,1 30x4 prefix="☁ " name="Running, idle"
  status=Idle icon="○" label="idle" line="○ idle" subtitle="canvas · main" elsewhere=true every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #8b949e]
  selected=false focused_term=false active=false
  vm=running
