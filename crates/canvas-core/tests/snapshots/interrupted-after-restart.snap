## gpu view model
view cursor=none modal=none banner=None
canvas area=34,1 81x38 origin=-1,0 scale=1 grid=true tick=0 empty=false
box working Session rect=1,1 30x4 prefix="" name="Was working"
  status=Interrupted icon="↯" label="interrupted" line="↯ interrupted" subtitle="canvas · main" elsewhere=false every=None mailbox=0
  border=Dashed border_style=[fg #e66100 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #e66100]
  selected=false focused_term=false active=false
box resuming Session rect=40,1 30x4 prefix="" name="Being resumed"
  status=Resuming icon="⠋" label="resuming after restart" line="⠋ resuming after restart" subtitle="canvas · main" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #c9d1d9]
  selected=false focused_term=false active=false
box idle Session rect=40,8 30x4 prefix="" name="Was idle"
  status=Stopped icon="■" label="stopped" line="■ stopped" subtitle="canvas · main" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #585e66]
  selected=false focused_term=false active=false
box looping Session rect=1,8 30x4 prefix="" name="Was looping"
  status=Interrupted icon="↯" label="interrupted" line="↯ interrupted · ↻ every 15m" subtitle="canvas · main" elsewhere=false every=None mailbox=0
  border=Heavy border_style=[fg #f0f6fc +BOLD] fill=#161b22 attention=none name_style=[fg #f0f6fc +BOLD] line_style=[fg #e66100]
  selected=true focused_term=false active=false
loops motion=On frozen=true
loop looping rect=1,8 30x4 halo=false lap=0.748 grow=1 ending=false interrupted
