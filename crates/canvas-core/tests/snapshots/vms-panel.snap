## gpu view model
view cursor=none modal=none banner=None
canvas area=34,1 43x38 origin=-1,0 scale=1 grid=true tick=0 empty=false
box v1 Session rect=1,1 30x4 prefix="☁ " name="Fix the flaky test"
  status=Stopped icon="■" label="stopped" line="■ stopped" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #585e66]
  selected=false focused_term=false active=false
  vm=running
box v2 Session rect=1,9 30x4 prefix="☁ " name="Upgrade the SDK"
  status=Stopped icon="■" label="stopped" line="☁ queued: 1 of 1 VMs are running" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #6e7681]
  selected=false focused_term=false active=false
  vm=queued
