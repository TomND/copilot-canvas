## gpu view model
view cursor=none modal=none banner=None
canvas area=34,1 52x38 origin=-2,-1 scale=1 grid=true tick=0 empty=false
group g1 "Payments" icon=▣ members=1 rect=0,0 40x10 color=#56b4e9 style=[fg #56b4e9 +DIM] selected=false drop_target=false automations=false folder=true
  chip " ⟲+ " action=Visual(GroupPassives("g1")) rect=18,0 4x1 fixed=false lit=false
  chip " ✎ Notes " action=Notebook(OpenGroup("g1")) rect=23,0 9x1 fixed=false lit=true
  chip " ☑+ " action=Tasks(LinkBoards("g1")) rect=33,0 4x1 fixed=false lit=false
box s-fix Session rect=2,2 30x4 prefix="" name="Fix flaky test"
  status=Stopped icon="■" label="stopped" line="■ stopped" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #585e66]
  selected=false focused_term=false active=false
