## gpu view model
view cursor=none modal=none banner=None
canvas area=34,1 52x38 origin=-1,-1 scale=1 grid=true tick=0 empty=false
group g-agents "Canvas agents" icon=◎ members=3 rect=0,10 104x8 color=#cc79a7 style=[fg #cc79a7 +DIM] selected=false drop_target=false automations=false folder=false
  chip " ◎ 3 · manage " action=Agents(Panel) rect=76,10 14x1 fixed=false lit=true
  chip " ✦ Skills " action=Agents(Library) rect=91,10 10x1 fixed=false lit=true
group g-pay "Payments" icon=▣ members=2 rect=0,0 70x8 color=#56b4e9 style=[fg #56b4e9 +DIM] selected=false drop_target=false automations=false folder=true
  chip " ⟲ 1 passive " action=Visual(GroupPassives("g-pay")) rect=30,0 13x1 fixed=false lit=true
  chip " ◧ AI docs " action=OpenGroupFolder("g-pay", false) rect=44,0 11x1 fixed=false lit=true
  chip " ◨ Outputs " action=OpenGroupFolder("g-pay", true) rect=56,0 11x1 fixed=false lit=true
box s-fix Session rect=2,2 30x4 prefix="" name="Fix flaky test"
  status=Stopped icon="■" label="stopped" line="■ stopped" subtitle="canvas" elsewhere=false every=None mailbox=0
  border=Round border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #585e66]
  selected=false focused_term=false active=false
box p-guard Passive rect=36,2 30x4 prefix="⟲ " name="Drift guard"
  status=Idle icon="○" label="idle" line="○ waiting" subtitle="on pr.pushed" elsewhere=false every=Some("on pr.pushed") mailbox=0
  border=Dashed border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #8b949e]
  selected=false focused_term=false active=false
box a-pr Passive rect=2,12 30x4 prefix="◎ " name="PR coordinator"
  status=Idle icon="●" label="idle" line="● monitoring · 2 PRs tracked" subtitle="on pr.*, build.failed" elsewhere=false every=Some("on pr.*, build.failed") mailbox=0
  border=Dashed border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #56b4e9]
  selected=false focused_term=false active=false
box a-digest Passive rect=36,12 30x4 prefix="◎ " name="Cross-group digest"
  status=Stopped icon="‖" label="stopped" line="‖ paused" subtitle="on session.done" elsewhere=false every=None mailbox=0
  border=Dashed border_style=[fg #c9d1d9 +DIM] fill=#161b22 attention=none name_style=[fg #c9d1d9] line_style=[fg #8b949e]
  selected=false focused_term=false active=false
loops motion=On frozen=true
loop p-guard rect=36,2 30x4 halo=false lap=0.623 grow=1 ending=false
loop a-pr rect=2,12 30x4 halo=false lap=0.153 grow=1 ending=false
